<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="Controller.EditUserController"
           prefWidth="600" prefHeight="720"
           styleClass="edit-user-root">
    <stylesheets>
        <URL value="@style.css"/>
        <URL value="@user-pro.css"/>
    </stylesheets>

    <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="auth-scroll-pane">
        <VBox alignment="CENTER" styleClass="auth-scroll-content">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

    <VBox spacing="20" styleClass="edit-user-card" maxWidth="500">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <!-- Title -->
        <Label text="Modifier le profil" styleClass="edit-user-title"/>

        <!-- Profile Image -->
        <VBox alignment="CENTER" spacing="10">
            <ImageView fx:id="profileImageView"
                       fitWidth="100" fitHeight="100"
                       styleClass="edit-user-profile"/>
            <Button fx:id="uploadImageButton"
                    text="Changer la photo"
                    styleClass="edit-user-upload"/>
        </VBox>

        <!-- Form -->
        <GridPane hgap="15" vgap="12">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <!-- First Name -->
            <Label text="Prénom" styleClass="edit-user-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="nomField" promptText="Prénom" styleClass="edit-user-field" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

            <!-- Last Name -->
            <Label text="Nom" styleClass="edit-user-label" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <TextField fx:id="prenomField" promptText="Nom" styleClass="edit-user-field" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <!-- Email -->
            <Label text="Email" styleClass="edit-user-label" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2"/>
            <TextField fx:id="emailField" promptText="Email" styleClass="edit-user-field" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2"/>

            <!-- Password -->
            <Label text="Mot de passe (laisser vide pour conserver)" styleClass="edit-user-label" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2"/>
            <PasswordField fx:id="passwordField" promptText="Nouveau mot de passe" styleClass="edit-user-field" GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2"/>

            <!-- Date of Birth -->
            <Label text="Date de naissance" styleClass="edit-user-label" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
            <DatePicker fx:id="datePicker" promptText="Choisir une date" styleClass="edit-user-field" GridPane.columnIndex="0" GridPane.rowIndex="7"/>

            <!-- Gender -->
            <Label text="Genre" styleClass="edit-user-label" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
            <ComboBox fx:id="genreBox" promptText="Choisir un genre" styleClass="edit-user-field" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

            <!-- Address -->
            <Label text="Adresse" styleClass="edit-user-label" GridPane.columnIndex="0" GridPane.rowIndex="8" GridPane.columnSpan="2"/>
            <TextField fx:id="adresseField" promptText="Adresse" styleClass="edit-user-field" GridPane.columnIndex="0" GridPane.rowIndex="9" GridPane.columnSpan="2"/>

            <!-- Phone -->
            <Label text="Téléphone" styleClass="edit-user-label" GridPane.columnIndex="0" GridPane.rowIndex="10"/>
            <TextField fx:id="phoneField" promptText="Numéro de téléphone" styleClass="edit-user-field" GridPane.columnIndex="0" GridPane.rowIndex="11"/>

            <!-- Role -->
            <Label text="Rôle" styleClass="edit-user-label" GridPane.columnIndex="1" GridPane.rowIndex="10"/>
            <ComboBox fx:id="roleBox" promptText="Choisir un rôle" styleClass="edit-user-field" GridPane.columnIndex="1" GridPane.rowIndex="11"/>

            <!-- Banned toggle -->
            <CheckBox fx:id="bannedCheck" text="Compte suspendu" styleClass="edit-user-label" GridPane.columnIndex="0" GridPane.rowIndex="12" GridPane.columnSpan="2"/>
        </GridPane>

        <!-- Error/Success Message -->
        <Label fx:id="errorLabel"
               text=""
               wrapText="true"
               visible="false"
               styleClass="edit-user-message"/>

        <!-- Buttons -->
        <HBox spacing="15" alignment="CENTER">
            <Button fx:id="saveButton" text="Enregistrer" styleClass="edit-user-save"/>
            <Button fx:id="cancelButton" text="Annuler" styleClass="edit-user-cancel"/>
        </HBox>
    </VBox>
        </VBox>
    </ScrollPane>
</StackPane>