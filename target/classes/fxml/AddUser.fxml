<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<StackPane styleClass="add-user-root"
           prefHeight="500" prefWidth="640"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Controller.AddUserController">
    <stylesheets>
        <URL value="@style.css"/>
        <URL value="@user-pro.css"/>
    </stylesheets>

    <VBox spacing="22" maxWidth="540" styleClass="add-user-card">
        <padding>
            <Insets top="6" right="6" bottom="6" left="6"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="14">
            <Label text="🌿" style="-fx-font-size: 22px;"/>
            <VBox spacing="2">
                <Label text="Ajouter un utilisateur" styleClass="add-user-title"/>
                <Label text="Crée une fiche minimale, complète-la ensuite depuis le profil" styleClass="add-user-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Voir les utilisateurs"
                    onAction="#navigateShowUsers"
                    styleClass="add-user-secondary"/>
        </HBox>

        <GridPane hgap="18" vgap="14">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>

            <Label text="Prénom" styleClass="add-user-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label text="Nom" styleClass="add-user-label" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <TextField fx:id="firstNameTf" promptText="Prénom" styleClass="add-user-field"
                       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="lastNameTf" promptText="Nom" styleClass="add-user-field"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Adresse email" styleClass="add-user-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2"/>
            <TextField fx:id="emailTf" promptText="ex. agriculteur@agricor.tn"
                       styleClass="add-user-field"
                       GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2"/>

            <rowConstraints>
                <RowConstraints/>
                <RowConstraints/>
                <RowConstraints/>
                <RowConstraints/>
            </rowConstraints>
        </GridPane>

        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button text="Enregistrer" onAction="#saveUser" styleClass="add-user-save"/>
        </HBox>
    </VBox>
</StackPane>
