<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-background-color: #f0f7f0; -fx-padding: 25;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.ShowSuiviAnimalController">

    <!-- Barre recherche + tri -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Rechercher un suivi..."
                   prefWidth="400"
                   style="-fx-background-radius:12; -fx-padding:11;
                          -fx-background-color:white; -fx-font-size:13px;
                          -fx-border-color:#b2dfb2; -fx-border-radius:12;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Trier par :" style="-fx-text-fill:#4a7c59; -fx-font-weight:bold; -fx-font-size:13px;"/>
        <ComboBox fx:id="triCombo" prefWidth="200"
                  style="-fx-background-radius:10; -fx-background-color:white;
                         -fx-border-color:#b2dfb2; -fx-border-radius:10; -fx-font-size:12px;"/>
    </HBox>

    <!-- Titre + boutons -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="3">
            <Label text="Suivi de Sante"
                   style="-fx-font-size:26px; -fx-font-weight:bold; -fx-text-fill:#1b5e20;"/>
            <Label text="Consultez et gerez l'etat de sante de vos animaux"
                   style="-fx-text-fill:#66bb6a; -fx-font-size:12px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Ajouter Suivi" onAction="#navigateAddSuivi"
                style="-fx-background-color:#2e7d32; -fx-text-fill:white; -fx-background-radius:10;
                       -fx-padding:10 18; -fx-font-weight:bold; -fx-cursor:hand; -fx-font-size:12px;"/>
        <Button text="Stats" onAction="#navigateStatistiques"
                style="-fx-background-color:#6a1b9a; -fx-text-fill:white; -fx-background-radius:10;
                       -fx-padding:10 18; -fx-font-weight:bold; -fx-cursor:hand; -fx-font-size:12px;"/>
        <Button text="Retour" onAction="#navigateBack"
                style="-fx-background-color:#c62828; -fx-text-fill:white; -fx-background-radius:10;
                       -fx-padding:10 18; -fx-font-weight:bold; -fx-cursor:hand; -fx-font-size:12px;"/>
    </HBox>

    <!-- Grille de cartes suivis -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color:transparent; -fx-background:transparent;
                       -fx-border-color:transparent;">
        <FlowPane fx:id="suiviGrid" hgap="18" vgap="18"
                  style="-fx-padding:5; -fx-background-color:transparent;"
                  prefWrapLength="800"/>
    </ScrollPane>

</VBox>
