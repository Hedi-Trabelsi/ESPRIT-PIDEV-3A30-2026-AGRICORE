<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane prefHeight="700.0" prefWidth="1160.0"
            styleClass="show-users-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.ShowUsersController">
    <stylesheets>
        <URL value="@style.css"/>
        <URL value="@user-pro.css"/>
    </stylesheets>

    <children>
        <VBox spacing="0.0"
              AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>

                <!-- ═══ TOP BAR ═══ -->
                <HBox alignment="CENTER_LEFT" spacing="0.0" styleClass="show-users-topbar">
                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="14.0" HBox.hgrow="ALWAYS">
                            <children>
                                <StackPane prefWidth="42" prefHeight="42" styleClass="show-users-brand-icon">
                                    <children>
                                        <Label text="🌿" style="-fx-font-size: 19px;"/>
                                    </children>
                                </StackPane>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label text="Communauté agricole" styleClass="show-users-brand-title"/>
                                        <Label fx:id="countLabel" text="membres enregistrés"
                                               styleClass="show-users-brand-subtitle"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <children>
                                <ComboBox fx:id="statusFilter"
                                          promptText="Statut"
                                          styleClass="show-users-status-filter"/>
                                <StackPane>
                                    <children>
                                        <TextField fx:id="searchField"
                                                   promptText="Rechercher un membre…"
                                                   styleClass="show-users-search"/>
                                        <Label text="🔍" styleClass="show-users-search-icon"
                                               StackPane.alignment="CENTER_LEFT"/>
                                    </children>
                                </StackPane>
                                <Button fx:id="refreshBtn" text="↻  Rafraîchir"
                                        onAction="#refreshCards"
                                        styleClass="show-users-refresh-btn"/>
                            </children>
                        </HBox>

                    </children>
                </HBox>

                <!-- ═══ STATS ROW ═══ -->
                <HBox spacing="14.0" styleClass="show-users-stats-row">
                    <children>

                        <HBox spacing="14" HBox.hgrow="ALWAYS" styleClass="show-users-stat-card" alignment="CENTER_LEFT">
                            <Label text="🌱" styleClass="show-users-stat-icon"/>
                            <VBox spacing="2">
                                <Label text="3" styleClass="show-users-stat-number"/>
                                <Label text="TOTAL MEMBRES" styleClass="show-users-stat-label"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="14" HBox.hgrow="ALWAYS" styleClass="show-users-stat-card" alignment="CENTER_LEFT">
                            <Label text="✓" styleClass="show-users-stat-icon"/>
                            <VBox spacing="2">
                                <Label fx:id="statActifs" text="2" styleClass="show-users-stat-number"/>
                                <Label text="ACTIFS AUJOURD'HUI" styleClass="show-users-stat-label"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="14" HBox.hgrow="ALWAYS" styleClass="show-users-stat-card" alignment="CENTER_LEFT">
                            <Label text="🚫" styleClass="show-users-stat-icon"/>
                            <VBox spacing="2">
                                <Label fx:id="statDepenses" text="0" styleClass="show-users-stat-number"/>
                                <Label text="COMPTES SUSPENDUS" styleClass="show-users-stat-label"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="14" HBox.hgrow="ALWAYS" styleClass="show-users-stat-card" alignment="CENTER_LEFT">
                            <Label text="🚜" styleClass="show-users-stat-icon"/>
                            <VBox spacing="2">
                                <Label fx:id="statRoles" text="3" styleClass="show-users-stat-number"/>
                                <Label text="RÔLES AGRICULTEUR" styleClass="show-users-stat-label"/>
                            </VBox>
                        </HBox>

                    </children>
                </HBox>

                <!-- ═══ SECTION HEADER ═══ -->
                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="show-users-section-header">
                    <children>
                        <Label text="Tous les membres" styleClass="show-users-section-title"/>
                        <Region HBox.hgrow="ALWAYS" styleClass="show-users-section-rule"/>
                        <Label fx:id="visibleBadge" text="3 affiché(s)" styleClass="show-users-visible-badge"/>
                    </children>
                </HBox>

                <!-- ═══ CARDS ═══ -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="show-users-cards-scroll">
                    <content>
                        <FlowPane fx:id="cardsPane"
                                  hgap="16.0" vgap="16.0"
                                  prefWrapLength="1100.0"
                                  style="-fx-background-color: transparent; -fx-padding: 4 0 24 0;"/>
                    </content>
                </ScrollPane>

            </children>
        </VBox>
    </children>
</AnchorPane>
